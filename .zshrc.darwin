# .zshrc.darwin — macOS-specific config
# Sourced by .zshrc on Darwin only

# ── Homebrew ─────────────────────────────────────────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"

# ── NVM (Homebrew) ───────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && source "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && source "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# ── 1Password SSH agent ─────────────────────────────────────────────
export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# ── Powerlevel10k & zsh plugins (Homebrew) ───────────────────────────
source "$(brew --prefix)/share/powerlevel10k/powerlevel10k.zsh-theme"
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# ── tfenv (Terraform version manager) ────────────────────────────────
# Git-cloned to ~/.tfenv, NOT brew — the tfenv formula declares
# conflicts_with "terraform", so brew-installing it forces a
# `brew unlink terraform`. Prepended ahead of /opt/homebrew/bin so the
# tfenv shim wins over any brew terraform.
[ -d "$HOME/.tfenv/bin" ] && export PATH="$HOME/.tfenv/bin:$PATH"
